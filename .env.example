# GEMINI_API_KEY: Required for server-side Bujji AI 2.0 Gemini API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# PORT: HTTP port for the Express + Vite server (defaults to 3000).
PORT="3000"

# APP_URL: Public URL where StudyDuo is hosted (used for shareable invite links).
APP_URL="http://localhost:3000"

# Optional client-side Firebase overrides (defaults to firebase-applet-config.json when omitted):
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

