# GEMINI_API_KEY: Required for server-side Gemini AI Study Assistant calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: Public URL where StudyDuo is hosted (used for shareable invite links).
APP_URL="http://localhost:3000"

# Firebase configuration is managed via firebase-applet-config.json (auto-generated by Firebase provisioning).
# For custom external deployments, configure Firebase web credentials in firebase-applet-config.json.
